rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // 1. Settings & API Keys Collection (Compatible with other website)
    match /settings/{userId} {
      allow read, write: if isOwner(userId);
    }

    // 2. Users Collection (Profile, nickname, guest or Google login)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId);
    }

    // 3. Exam Results Collection (Compatible with other website)
    match /exam_results/{resultId} {
      // Allow any logged-in user to see results (Required for Global Leaderboard)
      allow read: if isSignedIn();
      
      // Allow users to save their own results 
      // Ensure the userId in the document matches the logged-in user's ID
      allow create: if isSignedIn() && (
        !('userId' in request.resource.data) || 
        request.resource.data.userId == request.auth.uid ||
        request.resource.data.userId == 'anonymous'
      );
      
      // Prevent tampering to maintain leaderboard integrity
      allow update, delete: if false; 
    }

    // 4. Attempts Collection (For Medical Secret File offline & online hub)
    match /attempts/{attemptId} {
      // Allow reading for global live leaderboard
      allow read: if true;
      
      // Allow saving exam attempts
      allow create: if isSignedIn() || true;
      
      // Prevent modifying or deleting past attempt records
      allow update, delete: if false;
    }
  }
}
